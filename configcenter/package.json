{
  "name": "configcenter",
  "version": "0.1.0",
  "description": "A unified DSH web configuration center for credentials and plugin installation.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.js.map",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.1": "compatible"
      }
    }
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "credentials",
    "environment-variables",
    "tarball",
    "plugin-management"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "pack:tarball": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "22.20.1",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.7",
    "jsdom": "25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rollup": "^4.63.3",
    "typescript": "5.7.2"
  }
}
